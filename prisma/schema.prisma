// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model State {
  id           String       @id @default(cuid())
  name         String
  abbreviation String       @unique
  slug         String       @unique
  dmvUrl       String
  flagUrl      String
  updatedAt    DateTime     @updatedAt
  scrapingLogs ScrapingLog[]
}

model Question {
  id            String   @id @default(cuid())
  text          String
  options       String   // JSON string[]
  correctAnswer Int
  explanation   String
  category      String   // permit, drivers, motorcycle
  topic         String
  states        String   // JSON string[] - state codes or ['ALL']
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TestSession {
  id             String   @id @default(cuid())
  stateSlug      String
  testType       String
  score          Int
  totalQuestions Int
  passed         Boolean
  answers        String   // JSON
  createdAt      DateTime @default(now())
  ipHash         String
}

model ScrapingLog {
  id           String   @id @default(cuid())
  stateId      String
  state        State    @relation(fields: [stateId], references: [id])
  status       String
  changesFound Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
}
