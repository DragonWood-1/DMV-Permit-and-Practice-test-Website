# Database
DATABASE_URL="file:./dev.db"

# Scraping API Key (generate a random secret for manual POST trigger)
SCRAPE_API_KEY="your-secret-api-key-here"

# Vercel Cron Secret (set automatically by Vercel for cron jobs)
CRON_SECRET="your-vercel-cron-secret-here"

# Public site URL
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Environment
NODE_ENV="development"
